                                </div>
                            </form>
                            <p class="small mt-2 mb-0">
                                By subscribing you agree to our <a href="/terms">Terms & Conditions</a> and <a href="/privacy">Privacy & Cookies Policy</a>.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="border-top">
                <!-- Main Footer Content -->
                <div class="container py-5">
                    <div class="row g-4">
                        <!-- Help Section -->
                        <div class="col-lg-3 col-md-6">
                            <h5 class="mb-4">Do You Need Help ?</h5>
                            <div class="mb-4">
                                <p class="text-muted mb-1">Lorem ipsum dolor sit amet consectetur. Semper nisi adipiscing sagittis at purus.</p>
                            </div>
                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-phone-alt me-2 text-primary"></i>
                                <div>
                                    <div class="text-muted small">Monday-Friday: 08am-9pm</div>
                                    <a href="tel:0800300353" class="text-dark text-decoration-none fw-medium">0 800 300-353</a>
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <i class="far fa-envelope me-2 text-primary"></i>
                                <div>
                                    <div class="text-muted small">Need help with your order?</div>
                                    <a href="mailto:info@example.com" class="text-dark text-decoration-none fw-medium">info@example.com</a>
                                </div>
                            </div>
                        </div>

                     

                        <!-- Help You Section -->
                        <div class="col-lg-3 col-md-6">
                            <h5 class="mb-4">Let Us Help You</h5>
                            <ul class="list-unstyled mb-0">
                                
                                <li class="mb-2"><a href="/refund-policy">Refund and Returns Policy</a></li>
                                <li class="mb-2"><a href="/privacy-policy">Privacy Policy</a></li>
                                <li class="mb-2"><a href="/terms">Terms and Conditions</a></li>
                                <li class="mb-2"><a href="/cookie-settings">Cookie Settings</a></li>
                                <li class="mb-2"><a href="/help">Help Center</a></li>
                            </ul>
                        </div>

                        <!-- Get to Know Us Section -->
