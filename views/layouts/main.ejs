<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JinStore - Your One-Stop Shopping Destination</title>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
    <div class="main-wrapper">
        <!-- Top Announcement Bar -->
        <div class="announcement-bar py-2">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-white">FREE delivery & 40% Discount for next 3 orders! Place your 1st order in.</span>
                    </div>
                    <div class="countdown text-white">
                        Until the end of the sale: 
                        <span class="time">47</span> days
                        <span class="time">06</span> hours
                        <span class="time">55</span> minutes
                        <span class="time">51</span> sec.
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Links Bar -->
        <div class="top-links-bar py-2 bg-white border-bottom">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex gap-4">
                        <a href="/about">About Us</a>
                        <a href="/account">My account</a>
                        <a href="/wishlist">Wishlist</a>
                        <span class="delivery-time">We deliver to you every day from <span class="text-danger">7:00 to 23:00</span></span>
                    </div>
                    <div class="d-flex gap-4">
                        <div class="dropdown">
                            <a class="dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                English
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">English</a></li>
                                <li><a class="dropdown-item" href="#">Spanish</a></li>
                            </ul>
                        </div>
                        <div class="dropdown">
                            <a class="dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                USD
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">USD</a></li>
                                <li><a class="dropdown-item" href="#">EUR</a></li>
                            </ul>
                        </div>
                        <a href="/order-tracking">Order Tracking</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Header -->
        <header class="main-header py-4 bg-white">
            <div class="container">
                <div class="row align-items-center">
                    <!-- Logo -->
                    <div class="col-auto">
                        <a class="navbar-brand d-flex align-items-center" href="/">
                            <div class="logo-icon me-2">
                                <img src="/images/logo.png" alt="JinStore" height="40">
                            </div>
                            <span class="logo-text">JinStore</span>
                        </a>
                    </div>

                    <!-- Location -->
                    <div class="col-auto">
                        <div class="location-selector">
                            <i class="fas fa-map-marker-alt me-2"></i>
                            Deliver to
                            <span class="ms-1">all</span>
                        </div>
                    </div>

                    <!-- Search Bar -->
                    <div class="col">
                        <div class="search-bar">
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="Search for products, categories or brands...">
                                <button class="btn btn-primary" type="button">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- User Actions -->
                    <div class="col-auto">
                        <div class="user-actions">
                            <a href="/account" class="d-flex align-items-center gap-2">
                                <i class="fas fa-user"></i>
                                <div class="d-flex flex-column">
                                    <span class="small">Sign in</span>
                                    <span class="fw-500">Account</span>
                                </div>
                            </a>
                            <a href="/wishlist" class="position-relative">
                                <i class="fas fa-heart"></i>
                                <span class="badge">0</span>
                            </a>
                            <a href="/cart" class="position-relative">
                                <i class="fas fa-shopping-cart"></i>
                                <span class="badge">0</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Navigation -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-top border-bottom">
            <div class="container">
                <!-- Categories Menu -->
                <div class="navbar-categories">
                    <button class="btn btn-light d-flex align-items-center" type="button" data-bs-toggle="collapse" data-bs-target="#categoriesMenu">
                        <i class="fas fa-bars me-2"></i>
                        All Categories
                    </button>
                </div>

                <!-- Main Menu -->
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link active" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/shop">Shop</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/fruits-vegetables">Fruits & Vegetables</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/beverages">Beverages</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/blog">Blog</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/contact">Contact</a>
                    </li>
                </ul>

                <!-- Trending Products -->
                <div class="trending-products">
                    <a href="/trending">
                        Trending Products
                        <span class="badge bg-danger">Hot</span>
                    </a>
                    <a href="/almost-finished">
                        Almost Finished
                        <span class="badge bg-danger">Sale</span>
                    </a>
                </div>
            </div>
        </nav>

        <!-- Main Content Area -->
        <main class="content-wrapper">
            <%- body %>
        </main>

        <!-- Footer -->
        <footer class="footer bg-white">
            <!-- Newsletter Section -->
            <div class="newsletter-section py-5">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-5">
                            <h2 class="h3 mb-2">Join our newsletter for £10 offs</h2>
                            <p class="text-muted mb-0">Register now to get latest updates on promotions & coupons.Don't worry, we not spam!</p>
                        </div>
                        <div class="col-lg-7">
                            <form class="newsletter-form d-flex align-items-center">
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0">
                                        <i class="far fa-envelope text-muted"></i>
                                    </span>
                                    <input type="email" class="form-control border-start-0" placeholder="Enter your email address">
                                    <button class="btn btn-primary" type="submit">SEND</button>
                                </div>
                            </form>
                            <p class="small mt-2 mb-0">
                                By subscribing you agree to our <a href="/terms">Terms & Conditions</a> and <a href="/privacy">Privacy & Cookies Policy</a>.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="border-top">
                <!-- Main Footer Content -->
                <div class="container py-5">
                    <div class="row g-4">
                        <!-- Help Section -->
                        <div class="col-lg-3 col-md-6">
                            <h5 class="mb-4">Do You Need Help ?</h5>
                            <div class="mb-4">
                                <p class="text-muted mb-1">Autosellgen syr. Nek diarask fröbomba. Nör antipol kynoda nynat. Pressa fåmoska.</p>
                            </div>
                            <div class="d-flex align-items-center mb-3">
                                <i class="fas fa-phone-alt me-2 text-primary"></i>
                                <div>
                                    <div class="text-muted small">Monday-Friday: 08am-9pm</div>
                                    <a href="tel:0800300353" class="text-dark text-decoration-none fw-medium">0 800 300-353</a>
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <i class="far fa-envelope me-2 text-primary"></i>
                                <div>
                                    <div class="text-muted small">Need help with your order?</div>
                                    <a href="mailto:info@example.com" class="text-dark text-decoration-none fw-medium">info@example.com</a>
                                </div>
                            </div>
                        </div>

                        <!-- Make Money Section -->
                        <div class="col-lg-3 col-md-6">
                            <h5 class="mb-4">Make Money with Us</h5>
                            <ul class="list-unstyled mb-0">
                                <li class="mb-2"><a href="/sell-on-grogin">Sell on Grogin</a></li>
                                <li class="mb-2"><a href="/sell-services">Sell Your Services on Grogin</a></li>
                                <li class="mb-2"><a href="/sell-business">Sell on Grogin Business</a></li>
                                <li class="mb-2"><a href="/sell-apps">Sell Your Apps on Grogin</a></li>
                                <li class="mb-2"><a href="/become-affiliate">Become an Affiliate</a></li>
                                <li class="mb-2"><a href="/advertise">Advertise Your Products</a></li>
                                <li class="mb-2"><a href="/self-publish">Self-Publish with Us</a></li>
                                <li class="mb-2"><a href="/become-vendor">Become an Blowwe Vendor</a></li>
                            </ul>
                        </div>

                        <!-- Help You Section -->
                        <div class="col-lg-3 col-md-6">
                            <h5 class="mb-4">Let Us Help You</h5>
                            <ul class="list-unstyled mb-0">
                                <li class="mb-2"><a href="/accessibility">Accessibility Statement</a></li>
                                <li class="mb-2"><a href="/your-orders">Your Orders</a></li>
                                <li class="mb-2"><a href="/returns">Returns & Replacements</a></li>
                                <li class="mb-2"><a href="/shipping">Shipping Rates & Policies</a></li>
                                <li class="mb-2"><a href="/refund-policy">Refund and Returns Policy</a></li>
                                <li class="mb-2"><a href="/privacy-policy">Privacy Policy</a></li>
                                <li class="mb-2"><a href="/terms">Terms and Conditions</a></li>
                                <li class="mb-2"><a href="/cookie-settings">Cookie Settings</a></li>
                                <li class="mb-2"><a href="/help">Help Center</a></li>
                            </ul>
                        </div>

                        <!-- Get to Know Us Section -->
                        <div class="col-lg-3 col-md-6">
                            <h5 class="mb-4">Download our app</h5>
                            <div class="mb-4">
                                <a href="#" class="d-block mb-3">
                                    <img src="/images/google-play.png" alt="Get it on Google Play" class="img-fluid">
                                    <span class="d-block text-muted small mt-1">Download App Get<br>10% Discount</span>
                                </a>
                                <a href="#" class="d-block">
                                    <img src="/images/app-store.png" alt="Download on App Store" class="img-fluid">
                                    <span class="d-block text-muted small mt-1">Download App Get<br>20% Discount</span>
                                </a>
                            </div>
                            <div>
                                <p class="mb-2">Follow us on social media:</p>
                                <div class="d-flex gap-2">
                                    <a href="#" class="social-link"><i class="fab fa-facebook-f"></i></a>
                                    <a href="#" class="social-link"><i class="fab fa-twitter"></i></a>
                                    <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
                                    <a href="#" class="social-link"><i class="fab fa-linkedin-in"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Copyright Section -->
                <div class="border-top py-4">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-lg-6">
                                <p class="mb-lg-0">Copyright 2024 © Jinstore WooCommerce WordPress Theme. All right reserved. Powered by <a href="#" class="text-primary">BlackRise Themes</a>.</p>
                            </div>
                            <div class="col-lg-6 text-lg-end">
                                <div class="d-flex justify-content-lg-end gap-3">
                                    <a href="/terms" class="text-body">Terms and Conditions</a>
                                    <a href="/privacy" class="text-body">Privacy Policy</a>
                                    <a href="/order-tracking" class="text-body">Order Tracking</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom JS -->
    <script src="/js/main.js"></script>
</body>
</html> 