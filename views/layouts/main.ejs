            <!-- Main Header -->
            <header class="main-header py-4 bg-white">
                <div class="container">
                    <div class="row align-items-center">
                        <!-- Logo -->
                        <div class="col-auto">
                            <a class="navbar-brand d-flex align-items-center" href="/">
                                <div class="logo-icon me-2">
                                    <img src="/images/logo/logo.svg" alt="ShopSphere" height="40">
                                </div>
                                <span class="logo-text">shop<span style="color: var(--color-primary);">sphere</span></span>
                            </a>
                        </div>

                      

                        <!-- Search Bar -->
                        <div class="col">
                            <div class="search-bar">
                                <div class="input-group">
                                    <input type="text" class="form-control" placeholder="Search for products, categories or brands...">
                                    <button class="btn btn-primary" type="button">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- User Actions -->
                        <div class="col-auto">
                            <div class="user-actions">
                                <% if (locals.user) { %>
                                    <div class="dropdown">
                                        <a href="#" class="d-flex align-items-center gap-2 dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fas fa-user"></i>
                                            <div class="d-flex flex-column">
                                                <span class="small">Hello,</span>
                                                <span class="fw-500"><%= user.name %></span>
                                            </div>
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end account-dropdown">
                                            <li><a class="dropdown-item" href="/account/profile">
                                                <i class="fas fa-user-circle me-2"></i>Profile
                                            </a></li>
                                            <li><a class="dropdown-item" href="/account/orders">
                                                <i class="fas fa-shopping-bag me-2"></i>Orders
                                            </a></li>
                                            <li><a class="dropdown-item" href="/account/wishlist">
                                                <i class="fas fa-heart me-2"></i>Wishlist
                                            </a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item text-danger" href="#" id="logoutBtn">
                                                <i class="fas fa-sign-out-alt me-2"></i>Logout
                                            </a></li>
                                        </ul>
                                    </div>
                                <% } else { %>
                                    <a href="/users/login" class="d-flex align-items-center gap-2">
                                        <i class="fas fa-user"></i>
                                        <div class="d-flex flex-column">
                                            <span class="small">Sign in</span>
                                            <span class="fw-500">Account</span>
                                        </div>
                                    </a>
                                <% } %>
                                <a href="/wishlist" class="position-relative">
                                    <i class="fas fa-heart"></i>
                                    <span class="badge bg-danger rounded-pill wishlist-count"><%= locals.wishlistCount || 0 %></span>
                                </a>
                                <a href="/cart" class="position-relative">
                                    <i class="fas fa-shopping-cart"></i>
                                    <span class="badge bg-danger rounded-pill cart-count"><%= locals.cartCount || 0 %></span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Navigation -->
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-top border-bottom">
                <div class="container">
                    <!-- Categories Menu -->
                    <div class="navbar-categories">
                        <button class="btn btn-light d-flex align-items-center" type="button" data-bs-toggle="collapse" data-bs-target="#categoriesMenu">
                            <i class="fas fa-bars me-2"></i>
                            All Categories
                        </button>
                    </div>

                    <!-- Main Menu -->
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link " href="/" data-nav-link>Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/shop" data-nav-link>Shop</a>
                        </li>
                        <li class="nav-item" 
                        <a class="nav-link" href="/aboutus">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/contact" data-nav-link>Contact</a>
                        </li>
                    </ul>

                    <!-- Trending Products -->
                    <div class="trending-products">
                        <a href="/trending">
                            Trending Products
                            <span class="badge bg-danger">Hot</span>
                        </a>
                        <a href="/almost-finished">
                            Almost Finished
                            <span class="badge bg-danger">Sale</span>
                        </a>
                    </div>
                </div>
            </nav>
        </div>

        <!-- Main Content Area -->
        <main class="content-wrapper mt-3">
            <%- body %>
        </main>

        <!-- Footer -->
        <footer class="footer bg-white">
            <!-- Newsletter Section -->
            <div class="newsletter-section py-5">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-5">
                            <h2 class="h3 mb-2">Join our newsletter</h2>
                            <p class="text-muted mb-2">Register now to get latest updates on promotions & coupons.Don't worry, we not spam!</p>
                        </div>
                        <div class="col-lg-7">
                            <form class="newsletter-form d-flex align-items-center">
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0">
                                        <i class="far fa-envelope text-muted"></i>
                                    </span>
                                    <input type="email" class="form-control border-start-0" placeholder="Enter your email address">
