

<!-- 2FA Verification Page -->
<div class="container-fluid py-12">
    <div class="row justify-content-center align-items-center g-0" style="min-height: calc(100vh - 100px);">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
            <div class="auth-card shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <!-- Form Title -->
                    <div class="text-center mb-4">
                        <h2 class="auth-title mb-2">Two-Factor Authentication</h2>
                        <p class="text-muted">Please enter your authentication code</p>
                    </div>

                    <!-- Flash Messages -->
                    <% if (messages && messages.error) { %>
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <%= messages.error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    <% } %>

                    <!-- 2FA Form -->
                    <form id="verify2FAForm" class="needs-validation" novalidate>
                        <!-- Code Field -->
                        <div class="mb-4">
                            <label for="code" class="auth-form-label mb-2">Authentication Code</label>
                            <input 
                                type="text" 
                                class="auth-form-input form-control form-control-lg text-center" 
                                id="code" 
                                name="code" 
                                placeholder="Enter 6-digit code"
                                pattern="[0-9]{6}"
                                maxlength="6"
                                required
                            >
                            <div class="invalid-feedback mt-2">
                                Please enter a valid 6-digit code.
                            </div>
                        </div>

                        <!-- Backup Code Toggle -->
                        <div class="mb-4">
                            <button type="button" class="btn btn-link p-0" id="toggleBackupCode">
                                Lost access to your authenticator app?
                            </button>
                        </div>

                        <!-- Backup Code Field (Hidden by default) -->
                        <div class="mb-4 d-none" id="backupCodeField">
                            <label for="backupCode" class="auth-form-label mb-2">Backup Code</label>
                            <input 
                                type="text" 
                                class="auth-form-input form-control form-control-lg" 
                                id="backupCode" 
                                name="backupCode" 
                                placeholder="Enter backup code"
                                disabled
                            >
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid mb-4">
                            <button type="submit" class="auth-button btn btn-lg">
                                Verify
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('verify2FAForm');
    const codeInput = document.getElementById('code');
    const backupCodeInput = document.getElementById('backupCode');
    const toggleBackupBtn = document.getElementById('toggleBackupCode');
    const backupCodeField = document.getElementById('backupCodeField');

    // Toggle between 2FA code and backup code
    toggleBackupBtn.addEventListener('click', function() {
        backupCodeField.classList.toggle('d-none');
        if (!backupCodeField.classList.contains('d-none')) {
            backupCodeInput.disabled = false;
            codeInput.disabled = true;
            codeInput.value = '';
        } else {
            backupCodeInput.disabled = true;
            codeInput.disabled = false;
            backupCodeInput.value = '';
        }
    });

    // Handle form submission
    form.addEventListener('submit', async function(event) {
        event.preventDefault();
        
        // Reset validation states
        form.classList.remove('was-validated');
        const submitButton = form.querySelector('button[type="submit"]');
        const originalButtonText = submitButton.innerHTML;
        
        try {
            // Show loading state
            submitButton.disabled = true;
            submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Verifying...';

            // Prepare form data
            const formData = {
                code: codeInput.value,
                backupCode: backupCodeInput.value
            };

            const response = await fetch('/api/auth/verify-2fa', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(formData)
            });

            const data = await response.json();

            if (response.ok) {
                // Show success message
                const alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-success alert-dismissible fade show';
                alertDiv.innerHTML = `
                    Verification successful! Redirecting...
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                `;
                form.insertBefore(alertDiv, form.firstChild);

                // Redirect after a short delay
                setTimeout(() => {
                    window.location.href = data.redirectUrl || '/';
                }, 1500);
            } else {
                // Reset button state
                submitButton.disabled = false;
                submitButton.innerHTML = originalButtonText;

                // Show error message
                const alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-danger alert-dismissible fade show';
                alertDiv.innerHTML = `
                    ${data.message || 'Verification failed. Please try again.'}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                `;
                form.insertBefore(alertDiv, form.firstChild);
            }
        } catch (error) {
            // Reset button state
            submitButton.disabled = false;
            submitButton.innerHTML = originalButtonText;

            // Show error message
            const alertDiv = document.createElement('div');
            alertDiv.className = 'alert alert-danger alert-dismissible fade show';
            alertDiv.innerHTML = `
                An error occurred. Please try again.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;
            form.insertBefore(alertDiv, form.firstChild);
        }
    });

    // Format code input
    codeInput.addEventListener('input', function() {
        this.value = this.value.replace(/\D/g, '').substring(0, 6);
        if (this.value.length === 6) {
            this.classList.add('is-valid');
        } else {
            this.classList.remove('is-valid');
        }
    });
});
</script>
