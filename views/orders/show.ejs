<div class="container py-5">
    <div class="checkout-progress mb-5">
        <div class="progress-step completed">
            <div class="step-icon">
                <i class="fas fa-user"></i>
            </div>
            <span class="step-label">Contact Info</span>
        </div>
        <div class="progress-step completed">
            <div class="step-icon">
                <i class="fas fa-credit-card"></i>
            </div>
            <span class="step-label">Payment</span>
        </div>
        <div class="progress-step active">
            <div class="step-icon">
                <i class="fas fa-check"></i>
            </div>
            <span class="step-label">Review</span>
        </div>
    </div>

    <div class="row g-4 ">
        <!-- Left Side: Order Details -->
        <div class="col-lg-8">
            <!-- Order Details Container -->
            <div class="checkout-card mb-4 p-2">
                <div class="card-body p-4">
                    <div class="section-header mb-4">
                        <h2 class="card-title mb-2">Order Details</h2>
                        <p class="text-muted">Order #<%= order.orderNumber %></p>
                    </div>

                     <!-- Shipping Address -->
                     <div class="shipping-info">
                        <h3 class="section-subtitle mb-3">Shipping Address</h3>
                        <div class="summary-card p-3">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-map-marker-alt me-2" style="color: var(--color-primary);"></i>
                                
                                    <p class="mb-1"><%= order.shippingAddress.street %></p>
                                    <p class="mb-1"><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.zipCode %></p>
                                    <p class="mb-0"><%= order.shippingAddress.country %></p>
                                
                            </div>
                        </div>
                    </div>

                    <!-- Order Status -->
                    <div class="order-status mb-4">
                        <h3 class="section-subtitle mb-3">Order Status</h3>
                        <div class="summary-card p-3">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-circle me-2" style="color: <%= order.status === 'completed' ? 'var(--color-success)' : 'var(--color-warning)' %>"></i>
                                <span><%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %></span>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Information -->
                    <div class="payment-info mb-4">
                        <h3 class="section-subtitle mb-3">Payment Information</h3>
                        <div class="summary-card p-3">
                            <div class="d-flex align-items-center mb-2">
                                <i class="fas fa-credit-card me-2" style="color: var(--color-primary);"></i>
                                <span>Payment Method: <%= order.paymentMethod %></span>
                            </div>
                            <div class="d-flex align-items-center">
                                <i class="fas fa-circle me-2" style="color: <%= order.paymentStatus === 'completed' ? 'var(--color-success)' : 'var(--color-warning)' %>"></i>
                                <span>Payment Status: <%= order.paymentStatus %></span>
                            </div>
                        </div>
                    </div>

                   
                </div>
            </div>

            <!-- Order Items Container -->
                
                <div class="card mb-4 p-2">
                    <div class="card-body">
                        <h4 class="card-title mb-4">Order Items</h4>
                        <% order.items.forEach(item => { %>
                            <div class="row align-items-center mb-3">
                                <div class="col-md-2">
                                    <img src="<%= item.product.images && item.product.images.length > 0 ? (item.product.images.find(img => img.isMain)?.url || item.product.images[0]?.url) : '/images/products/default-product.jpg' %>" 
                                         alt="<%= item.product.name %>" 
                                         class="img-fluid rounded">
                                </div>
                                <div class="col-md-4">
                                    <h6><%= item.product.name %></h6>
                                    <p class="text-muted mb-0">Quantity: <%= item.quantity %></p>
                                </div>
                                <div class="col-md-3 text-end">
                                    <p class="mb-0">$<%= item.price.toFixed(2) %> each</p>
                                </div>
                                <div class="col-md-3 text-end">
                                    <p class="mb-0">$<%= (item.price * item.quantity).toFixed(2) %></p>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>

        </div>

        <!-- Right Side: Order Summary and Payment -->
        <div class="col-lg-4">
            <!-- Order Summary Container -->
            <div class="checkout-card mb-4">
                <div class="card-body p-4">
                    <h4 class="card-title mb-2">Order Summary</h4>
                    
                    <div class="summary-card p-3 mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal</span>
                            <span>$<%= order.subtotal.toFixed(2) %></span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Shipping</span>
                            <span>$<%= order.shippingCost.toFixed(2) %></span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tax</span>
                            <span>$<%= order.tax.toFixed(2) %></span>
                        </div>
                        <div class="d-flex justify-content-between total-row">
                            <strong>Total</strong>
                            <strong class="total-amount">$<%= order.total.toFixed(2) %></strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Complete Payment Container -->
            <% if (order.paymentStatus !== 'completed' && order.status === 'pending') { %>
                <div class="checkout-card">
                    <div class="card-body p-4">
                        <h4 class="card-title mb-2">Complete Payment</h4>
                        <div class="summary-card p-3">
                            <p class="text-danger mb-3">Your payment was not completed. Please try again to complete your order.</p>
                            <div id="paypal-button-container"></div>
                        </div>

                        <!-- PayPal SDK -->
                        <script src="https://www.paypal.com/sdk/js?client-id=<%= process.env.PAYPAL_CLIENT_ID %>&currency=USD"></script>
                        <script>
                            document.addEventListener('DOMContentLoaded', function() {
                                paypal.Buttons({
                                    createOrder: function(data, actions) {
                                        return actions.order.create({
                                            purchase_units: [{
                                                amount: {
                                                    value: '<%= order.total.toFixed(2) %>',
                                                    currency_code: 'USD'
                                                }
                                            }]
                                        });
                                    },
                                    onApprove: async function(data, actions) {
                                        try {
                                            const details = await actions.order.capture();
                                            const response = await fetch('/api/payment/capture', {
                                                method: 'POST',
                                                headers: {
                                                    'Content-Type': 'application/json',
                                                },
                                                body: JSON.stringify({
                                                    orderId: '<%= order._id %>',
                                                    paypalOrderId: data.orderID,
                                                    paymentDetails: details
                                                })
                                            });

                                            if (!response.ok) {
                                                throw new Error('Failed to capture order');
                                            }

                                            window.location.reload();
                                        } catch (error) {
                                            console.error('Error:', error);
                                            alert('Error processing payment. Please try again.');
                                        }
                                    }
                                }).render('#paypal-button-container');
                            });
                        </script>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>