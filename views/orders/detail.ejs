<!-- Order Detail Page -->
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Order Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1">Order #<%= order.orderNumber %></h2>
                    <p class="text-muted mb-0">
                        Placed on <%= new Date(order.createdAt).toLocaleDateString('en-US', { 
                            year: 'numeric', 
                            month: 'long', 
                            day: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit'
                        }) %>
                    </p>
                </div>
                <div>
                    <a href="/orders/<%= order._id %>/invoice" class="btn btn-outline-primary">
                        <i class="fas fa-file-pdf"></i> Download Invoice
                    </a>
                </div>
            </div>

            <!-- Order Progress -->
            <div class="card mb-4">
                <div class="card-body">
                    <div class="order-progress">
                        <div class="progress-track">
                            <% const statuses = ['pending', 'processing', 'shipped', 'delivered'];
                               const currentIndex = statuses.indexOf(order.orderStatus);
                            %>
                            <% statuses.forEach((status, index) => { %>
                                <div class="progress-step <%= index <= currentIndex ? 'completed' : '' %>">
                                    <div class="step-icon">
                                        <i class="fas <%= 
                                            status === 'pending' ? 'fa-clock' :
                                            status === 'processing' ? 'fa-cog' :
                                            status === 'shipped' ? 'fa-truck' :
                                            'fa-check'
                                        %>"></i>
                                    </div>
                                    <div class="step-label"><%= status.charAt(0).toUpperCase() + status.slice(1) %></div>
                                    <% if (index === currentIndex) { %>
                                        <div class="step-date">
                                            <%= new Date().toLocaleDateString() %>
                                        </div>
                                    <% } %>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Order Details -->
                <div class="col-md-8">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Order Items</h5>
                        </div>
                        <div class="card-body">
                            <% order.items.forEach(item => { %>
                                <div class="order-item mb-3">
                                    <div class="row align-items-center">
                                        <div class="col-2">
                                            <img src="<%= item.product.images[0]?.url || '/images/placeholder.jpg' %>" 
                                                 alt="<%= item.product.name %>"
                                                 class="img-fluid rounded">
                                        </div>
                                        <div class="col-6">
                                            <h6 class="mb-1"><%= item.product.name %></h6>
                                            <small class="text-muted">Quantity: <%= item.quantity %></small>
                                        </div>
                                        <div class="col-4 text-end">
                                            <div class="price">$<%= (item.price * item.quantity).toFixed(2) %></div>
                                            <small class="text-muted">$<%= item.price.toFixed(2) %> each</small>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                </div>

                <!-- Order Summary -->
                <div class="col-md-4">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Order Summary</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal</span>
                                <span>$<%= order.subtotal.toFixed(2) %></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Shipping</span>
                                <span>$<%= order.shippingCost.toFixed(2) %></span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Tax</span>
                                <span>$<%= order.tax.toFixed(2) %></span>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between mb-0">
                                <strong>Total</strong>
                                <strong>$<%= order.total.toFixed(2) %></strong>
                            </div>
                        </div>
                    </div>

                    <!-- Shipping Information -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Shipping Information</h5>
                        </div>
                        <div class="card-body">
                            <address class="mb-0">
                                <%= order.shippingAddress.street %><br>
                                <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.zipCode %><br>
                                <%= order.shippingAddress.country %>
                            </address>
                            <% if (order.trackingNumber) { %>
                                <hr>
                                <div class="tracking-info">
                                    <strong>Tracking Number:</strong><br>
                                    <span class="tracking-number"><%= order.trackingNumber %></span>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.order-progress {
    padding: 20px 0;
}

.progress-track {
    display: flex;
    justify-content: space-between;
    position: relative;
    margin: 0 auto;
}

.progress-track::before {
    content: '';
    position: absolute;
    top: 25px;
    left: 0;
    width: 100%;
    height: 2px;
    background: #e9ecef;
    z-index: 1;
}

.progress-step {
    position: relative;
    z-index: 2;
    flex: 1;
    text-align: center;
}

.step-icon {
    width: 50px;
    height: 50px;
    background: #fff;
    border: 2px solid #e9ecef;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    color: #6c757d;
}

.progress-step.completed .step-icon {
    background: var(--primary-color);
    border-color: var(--primary-color);
    color: #fff;
}

.step-label {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: #6c757d;
}

.progress-step.completed .step-label {
    color: var(--primary-color);
}

.step-date {
    font-size: 0.75rem;
    color: #6c757d;
}

.order-item {
    padding-bottom: 1rem;
    border-bottom: 1px solid #e9ecef;
}

.order-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.tracking-number {
    font-family: monospace;
    font-size: 1.1rem;
    color: var(--primary-color);
}

@media (max-width: 768px) {
    .progress-track::before {
        display: none;
    }
    
    .progress-track {
        flex-direction: column;
        gap: 1rem;
    }
    
    .progress-step {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    
    .step-icon {
        margin: 0;
    }
    
    .step-label {
        margin-top: 0;
        text-align: left;
    }
}
</style>

