<div class="container mt-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/shop">Shop</a></li>
            <li class="breadcrumb-item active"><%= product.name %></li>
        </ol>
    </nav>

    <div class="row">
        <!-- Product Images -->
        <div class="col-md-6 mb-4">
            <div class="product-images">
                <div class="main-image mb-3">
                    <img src="<%= product.image %>" alt="<%= product.name %>" class="img-fluid rounded">
                    <% if (product.discount) { %>
                        <div class="badge-overlay">
                            <span class="badge bg-danger">-<%= product.discount %>%</span>
                        </div>
                    <% } %>
                </div>
                <div class="thumbnail-images">
                    <div class="row g-2">
                        <% product.thumbnails.forEach(thumbnail => { %>
                            <div class="col-3">
                                <img src="<%= thumbnail %>" alt="Thumbnail" class="img-fluid rounded cursor-pointer">
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Product Info -->
        <div class="col-md-6">
            <div class="product-info">
                <div class="category-badge mb-2">
                    <span class="badge bg-light text-dark"><%= product.category %></span>
                </div>
                
                <h1 class="product-title mb-3"><%= product.name %></h1>
                
                <div class="product-rating mb-3">
                    <div class="stars">
                        <% for(let i = 0; i < 5; i++) { %>
                            <i class="fas fa-star <%= i < Math.floor(product.rating) ? 'text-warning' : 'text-muted' %>"></i>
                        <% } %>
                    </div>
                    <span class="rating-count">(<%= product.reviewCount %> Reviews)</span>
                </div>

                <div class="product-price mb-4">
                    <% if (product.discount) { %>
                        <span class="new-price">$<%= product.price.toFixed(2) %></span>
                        <span class="old-price">$<%= product.originalPrice.toFixed(2) %></span>
                        <span class="discount-badge">(<%= product.discount %>% OFF)</span>
                    <% } else { %>
                        <span class="new-price">$<%= product.price.toFixed(2) %></span>
                    <% } %>
                </div>

                <div class="product-description mb-4">
                    <p><%= product.description %></p>
                </div>

                <div class="product-variants mb-4">
                    <h6 class="mb-2">Size</h6>
                    <div class="size-options">
                        <% ['S', 'M', 'L', 'XL'].forEach(size => { %>
                            <button class="btn btn-outline-secondary size-btn"><%= size %></button>
                        <% }); %>
                    </div>
                </div>

                <div class="quantity-selector mb-4">
                    <h6 class="mb-2">Quantity</h6>
                    <div class="d-flex align-items-center">
                        <button class="btn btn-outline-secondary quantity-btn" onclick="updateQuantity(-1)">-</button>
                        <input type="number" class="form-control quantity-input" value="1" min="1" id="quantity">
                        <button class="btn btn-outline-secondary quantity-btn" onclick="updateQuantity(1)">+</button>
                    </div>
                </div>

                <div class="product-actions">
                    <div class="row g-2">
                        <div class="col-8">
                            <button class="btn btn-primary w-100 add-to-cart-btn">
                                <i class="fas fa-shopping-cart me-2"></i>Add to Cart
                            </button>
                        </div>
                        <div class="col-4">
                            <button class="btn btn-outline-secondary w-100 wishlist-btn">
                                <i class="far fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="product-meta mt-4">
                    <div class="meta-item">
                        <span class="meta-label">SKU:</span>
                        <span class="meta-value"><%= product.sku %></span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-label">Category:</span>
                        <span class="meta-value"><%= product.category %></span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-label">Tags:</span>
                        <span class="meta-value"><%= product.tags.join(', ') %></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Product Tabs -->
    <div class="row mt-5">
        <div class="col-12">
            <ul class="nav nav-tabs" id="productTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#description">
                        Description
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#additional">
                        Additional Information
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#reviews">
                        Reviews (<%= product.reviewCount %>)
                    </button>
                </li>
            </ul>

            <div class="tab-content mt-4" id="productTabContent">
                <div class="tab-pane fade show active" id="description">
                    <%= product.fullDescription %>
                </div>
                <div class="tab-pane fade" id="additional">
                    <table class="table">
                        <tbody>
                            <% product.additionalInfo.forEach(info => { %>
                                <tr>
                                    <th><%= info.label %></th>
                                    <td><%= info.value %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                <div class="tab-pane fade" id="reviews">
                    <div class="reviews-summary">
                        <div class="overall-rating">
                            <h3><%= product.rating %> out of 5</h3>
                            <div class="stars">
                                <% for(let i = 0; i < 5; i++) { %>
                                    <i class="fas fa-star <%= i < Math.floor(product.rating) ? 'text-warning' : 'text-muted' %>"></i>
                                <% } %>
                            </div>
                            <p>Based on <%= product.reviewCount %> reviews</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    <div class="related-products mt-5">
        <h3 class="section-title mb-4">Related Products</h3>
        <div class="row g-4">
            <% relatedProducts.forEach(product => { %>
                <div class="col-6 col-md-3">
                    <div class="product-card">
                        <div class="product-image">
                            <img src="<%= product.image %>" alt="<%= product.name %>">
                            <% if (product.discount) { %>
                                <div class="badge-overlay">
                                    <span class="badge bg-danger">-<%= product.discount %>%</span>
                                </div>
                            <% } %>
                        </div>
                        <div class="product-info">
                            <h3><%= product.name %></h3>
                            <div class="price">
                                <span class="new-price">$<%= product.price.toFixed(2) %></span>
                                <span class="old-price">$<%= product.originalPrice.toFixed(2) %></span>
                            </div>
                            <div class="button-group">
                                <button class="btn-wishlist"><i class="fas fa-heart"></i></button>
                                <button class="btn-add">Add to cart</button>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</div>

<script>
function updateQuantity(change) {
    const quantityInput = document.getElementById('quantity');
    let newValue = parseInt(quantityInput.value) + change;
    if (newValue < 1) newValue = 1;
    quantityInput.value = newValue;
}

// Thumbnail image click handler
document.querySelectorAll('.thumbnail-images img').forEach(img => {
    img.addEventListener('click', function() {
        const mainImage = document.querySelector('.main-image img');
        mainImage.src = this.src;
    });
});
</script>