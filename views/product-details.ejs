<div class="container mt-4">
    <!-- Toast Container -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1500;">
        <div id="toast" class="toast align-items-center text-white border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body"></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" style="color: var(--color-primary);">Home</a></li>
            <li class="breadcrumb-item"><a href="/shop" style="color: var(--color-primary);">Shop</a></li>
            <% if (product && product.category) { %>
                <% if (product.category.parent) { %>
                    <li class="breadcrumb-item"><a href="/shop?category=<%= product.category.parent._id %>" style="color: var(--color-primary);"><%= product.category.parent.name %></a></li>
                    <li class="breadcrumb-item"><a href="/shop?category=<%= product.category._id %>" style="color: var(--color-primary);"><%= product.category.name %></a></li>
                <% } else { %>
                    <li class="breadcrumb-item"><a href="/shop?category=<%= product.category._id %>" style="color: var(--color-primary);"><%= product.category.name %></a></li>
                <% } %>
            <% } %>
            <li class="breadcrumb-item active" aria-current="page"><%= product ? product.name : 'Product Details' %></li>
        </ol>
    </nav>

    <% if (!product) { %>
        <!-- Product Not Found Message -->
        <div class="row">
            <div class="col-12 text-center py-5">
                <div class="product-not-found">
                    <i class="fas fa-exclamation-circle fa-4x mb-3 text-warning"></i>
                    <h2>Product Not Found</h2>
                    <p class="text-muted">The product you are looking for does not exist or has been removed.</p>
                    <a href="/shop" class="btn btn-primary mt-3">Return to Shop</a>
                </div>
            </div>
        </div>
    <% } else { %>
        <div class="row">
            <!-- Product Images -->
            <div class="col-lg-6">
                <div class="product-images">
                    <div class="main-image" style="height: 400px; display: flex; justify-content: center; align-items: center; overflow: hidden;">
                        <img src="<%= product.images && product.images.length > 0 ? (product.images.find(img => img.isMain)?.url || product.images[0]?.url) : '/images/products/default-product.jpg' %>" 
                             alt="<%= product.name %>" 
                             id="main-product-image"
                             style="width: 80%; height: 80%; object-fit: contain;">
                    </div>
                    <div class="thumbnail-images">
                        <% if (product.images && product.images.length > 0) { %>
                            <% product.images.forEach((image, index) => { %>
                                <div class="thumbnail">
                                    <img src="<%= image.url %>" 
                                         alt="<%= product.name %> - Image <%= index + 1 %>"
                                         onclick="changeMainImage(this.src)"
                                         style="width: 60px; height: 60px; object-fit: contain; cursor: pointer;">
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="thumbnail">
                                <img src="/images/products/default-product.jpg" 
                                     alt="Default Product Image" 
                                     onclick="changeMainImage(this.src)"
                                     style="width: 60px; height: 60px; object-fit: contain; cursor: pointer;">
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Product Info -->
            <div class="col-lg-6">
                <div class="product-info" data-product-id="<%= product._id %>">
                    <h1><%= product.name %></h1>
                    <div class="stock-status">
                        <span class="badge <%= product.stock > 0 ? 'bg-instock' : 'bg-outofstock' %>">
                            <%= product.stock > 0 ? 'In Stock' : 'Out of Stock' %>
                        </span>
                    </div>
                    
                    <!-- Add short description here -->
                    <div class="short-description mt-2 mb-3">
                        <p style="color: var(--color-body);"><%= product.shortDescription %></p>
                    </div>
                    
                    <!-- Category display -->
                    <div class="category mb-3">
                        <span style="color: var(--color-body-light);">Category: </span>
                        <% if (product.category && product.category.name) { %>
                            <% if (product.category.parent) { %>
                                <a href="/shop?category=<%= product.category.parent._id %>" class="text-primary-color"><%= product.category.parent.name %></a>
                                <span class="text-muted"> > </span>
                                <a href="/shop?category=<%= product.category._id %>" class="text-primary-color"><%= product.category.name %></a>
                            <% } else { %>
                                <a href="/shop?category=<%= product.category._id %>" class="text-primary-color"><%= product.category.name %></a>
                            <% } %>
                        <% } else { %>
                            <span class="text-muted">Uncategorized</span>
                        <% } %>
                </div>

                    <div class="rating">
                        <div class="stars">
                            <% const rating = product.averageRating || 0; %>
                            <% for(let i = 1; i <= 5; i++) { %>
                                <i class="fas fa-star <%= i <= rating ? 'active' : '' %>"></i>
                            <% } %>
                        </div>
                        <span class="review-count">(<%= product.reviews ? product.reviews.length : 0 %> reviews)</span>
                    </div>
                    <div class="price">
                        <span class="new-price">$<%= product.price.toFixed(2) %></span>
                    </div>
                   
                    <div class="quantity-selector">
                        <button class="btn-quantity" onclick="decrementQuantity()">-</button>
                        <input type="number" id="quantity" value="1" min="1" max="<%= product.stock %>">
                        <button class="btn-quantity" onclick="incrementQuantity()">+</button>
                        </div>

                    <!-- Add color selection if available -->
                    <% if (product.attributes && product.attributes.color && product.attributes.color.length > 0) { %>
                        <div class="attribute-selector mt-3">
                            <label class="attribute-label" style="color: var(--color-body-light);">Color:</label>
                            <div class="color-options">
                                <% product.attributes.color.forEach(color => { %>
                                    <div class="color-option">
                                        <input type="radio" name="color" id="color-<%= color %>" value="<%= color %>" class="color-input">
                                        <label for="color-<%= color %>" class="color-label" style="background-color: <%= color.toLowerCase() %>;">
                                            <span class="visually-hidden"><%= color %></span>
                                        </label>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>
                    
                    <!-- Add size selection if available -->
                    <% if (product.attributes && product.attributes.size && product.attributes.size.length > 0) { %>
                        <div class="attribute-selector mt-3">
                            <label class="attribute-label" style="color: var(--color-body-light);">Size:</label>
                            <div class="size-options">
                                <% product.attributes.size.forEach(size => { %>
                                    <div class="size-option">
                                        <input type="radio" name="size" id="size-<%= size %>" value="<%= size %>" class="size-input">
                                        <label for="size-<%= size %>" class="size-label" style="background-color: rgb(111, 72, 235, 0.1);
                                            border: 1px solid var(--color-primary);
                                            color: var(--color-primary);
                                            font-size: 0.875rem;;"><%= size %></label>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>
                    
                    <div class="action-buttons">
                        <% if (product.stock <= 0) { %>
                            <button class="btn-add-cart" disabled>
                                <i class="fas fa-shopping-cart"></i> Add to Cart
                            </button>
                        <% } else { %>
                            <button class="btn-add-cart" onclick="addToCart()">
                                <i class="fas fa-shopping-cart"></i> Add to Cart
                            </button>
                        <% } %>
                        <button class="btn-wishlist" data-product-id="<%= product._id %>">
                            <i class="fas fa-heart"></i>
                        </button>
                    </div>
                </div>
            </div>
                        </div>

        <!-- Product Tabs -->
        <div class="product-tabs mt-5">
            <ul class="nav nav-tabs" id="productTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="description-tab" data-bs-toggle="tab" data-bs-target="#description" type="button" role="tab">Description</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="specifications-tab" data-bs-toggle="tab" data-bs-target="#specifications" type="button" role="tab">Specifications</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab">Reviews</button>
                </li>
            </ul>
            <div class="tab-content" id="productTabsContent">
                <div class="tab-pane fade show active" id="description" role="tabpanel" aria-labelledby="description-tab">
                    <div class="product-description" style="color: var(--color-body);">
                        <% if (product.description) { %>
                            <%- product.description %>
                        <% } else { %>
                            <p>No description available for this product.</p>
                                        <% } %>
                                </div>
                            </div>

                <!-- Add specifications tab -->
                <div class="tab-pane fade" id="specifications" role="tabpanel">
                    <div class="specifications-content">
                        <% if (product.specifications && product.specifications.length > 0) { %>
                            <table class="table table-striped">
                                <tbody>
                                    <% product.specifications.forEach(spec => { %>
                                        <tr>
                                            <th scope="row" style="width: 30%; color: var(--color-heading);"><%= spec.name %></th>
                                            <td style="color: var(--color-body);"><%= spec.value %></td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        <% } else { %>
                            <p style="color: var(--color-body);">No specifications available for this product.</p>
                                                        <% } %>
                                                </div>
                                            </div>
                
                <div class="tab-pane fade" id="reviews" role="tabpanel" aria-labelledby="reviews-tab">
                    <div class="reviews-section">
                       
                        
                        <% if (locals.user) { %>
                            <!-- Review Form -->
                            <div class="review-form mb-4">
                                <h3 style="color: var(--color-heading);">Write a Review</h3>
                                <form id="reviewForm" class="mt-3">
                                    <div class="mb-3">
                                        <label class="form-label">Rating</label>
                                        <div class="rating-input">
                                            <input type="radio" name="rating" id="rating5" value="5" required>
                                            <label for="rating5" class="star-label"><i class="fas fa-star"></i></label>
                                            <input type="radio" name="rating" id="rating4" value="4">
                                            <label for="rating4" class="star-label"><i class="fas fa-star"></i></label>
                                            <input type="radio" name="rating" id="rating3" value="3">
                                            <label for="rating3" class="star-label"><i class="fas fa-star"></i></label>
                                            <input type="radio" name="rating" id="rating2" value="2">
                                            <label for="rating2" class="star-label"><i class="fas fa-star"></i></label>
                                            <input type="radio" name="rating" id="rating1" value="1">
                                            <label for="rating1" class="star-label"><i class="fas fa-star"></i></label>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label for="reviewTitle" class="form-label">Title</label>
                                        <input type="text" class="form-control" id="reviewTitle" name="title" required>
                                    </div>
                                    <div class="mb-3">
                                        <label for="reviewComment" class="form-label">Your Review</label>
                                        <textarea class="form-control" id="reviewComment" name="comment" rows="4" required></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary">Submit Review</button>
                                </form>
                            </div>
                        <% } else { %>
                            <div class="alert alert-info">
                                Please <a href="/users/login" style="color: var(--color-primary); font-weight: 600;">Log in</a> to write a review.
                            </div>
                        <% } %>

                            <h3 class="mb-4">Customer Reviews</h3>
                            <div id="reviewsList">
                                <% if (product.reviews && product.reviews.length > 0) { %>
                                    <% product.reviews.forEach(review => { %>
                                        <div class="review-item">
                                            <div class="review-header">
                                                <div class="reviewer-info">
                                                    <h5 class="reviewer-name"><%= review.user ? review.user.name || review.user.email : 'Anonymous' %></h5>
                                                    <div class="review-rating">
                                                        <% for(let i = 1; i <= 5; i++) { %>
                                                            <i class="fas fa-star <%= i <= review.rating ? 'text-warning' : 'text-muted' %>"></i>
                                                        <% } %>
                                                    </div>
                                                </div>
                                                <span class="review-date"><%= new Date(review.createdAt).toLocaleDateString() %></span>
                                            </div>
                                            <div class="review-content">
                                                <h6 class="review-title"><%= review.title %></h6>
                                                <p class="review-comment"><%= review.comment %></p>
                                            </div>
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <div class="text-center py-4">
                                        <i class="fas fa-comments fa-3x text-muted mb-3"></i>
                                        <p class="text-muted">No reviews yet. Be the first to review this product!</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        <!-- Related Products -->
        <div class="related-products mt-4 mb-4">
            <h2>Related Products</h2>
            <div class="row g-4">
                <% if (relatedProducts && relatedProducts.length > 0) { %>
                    <% relatedProducts.forEach(product => { %>
                        <div class="col-md-6 col-lg-3">
                            <div class="product-card" data-product-id="<%= product._id %>">
                                <div class="product-image">
                                    <img src="<%= product.images && product.images.length > 0 ? (product.images.find(img => img.isMain)?.url || product.images[0]?.url) : '/images/products/default-product.jpg' %>" 
                                         alt="<%= product.name %>">
                                    <% if (parseInt(product.stock) <= 0) { %>
                                        <div class="out-of-stock-overlay">
                                            <span>Out of Stock</span>
                                        </div>
                                    <% } %>
                                    <div class="badge-overlay">
                                        <span class="badge bg-danger">-15%</span>
                                    </div>
                                </div>
                                <div class="product-info">
                                    <h3><%= product.name %></h3>
                                    <div class="price">
                                        <span class="new-price">$<%= (product.price * 0.85).toFixed(2) %></span>
                                        <span class="old-price">$<%= product.price.toFixed(2) %></span>
                                    </div>
                                    <div class="button-group">
                                        <button class="btn-wishlist" data-product-id="<%= product._id %>">
                                            <i class="fas fa-heart"></i>
                                        </button>
                                        <button class="btn-add" data-product-id="<%= product._id %>" <%= parseInt(product.stock) <= 0 ? 'disabled' : '' %>>
                                            
                                                Add to cart
                                           
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="col-12 text-center">
                        <p class="text-muted">No related products found.</p>
                    </div>
                <% } %>
            </div>
        </div>
    <% } %>
    </div>

<!-- Add these before the closing body tag -->
<script src="/js/utils.js"></script>
<script src="/js/ui-utils.js"></script>
<script src="/js/cart.js"></script>
<script src="/js/wishlist.js"></script>

    <script>
// Remove client-side category handling and rely on server-side data
document.addEventListener('DOMContentLoaded', function() {
    // Log product data for debugging only
    const productData = <%- JSON.stringify(product || {}) %>;
    console.log('Product object from server:', productData);
});

function changeMainImage(src) {
    document.getElementById('main-product-image').src = src;
        }

        function incrementQuantity() {
            const input = document.getElementById('quantity');
            const max = parseInt(input.getAttribute('max'));
            const currentValue = parseInt(input.value);
            if (currentValue < max) {
                input.value = currentValue + 1;
            }
        }

        function decrementQuantity() {
            const input = document.getElementById('quantity');
            const currentValue = parseInt(input.value);
            if (currentValue > 1) {
                input.value = currentValue - 1;
            }
        }

function addToCart() {
    const productInfo = document.querySelector('.product-info');
    const productId = productInfo.dataset.productId;
    const quantity = document.getElementById('quantity').value;
    const sizeSelect = document.getElementById('size');
    const size = sizeSelect ? sizeSelect.value : null;

    fetch('/api/cart/add', {
                    method: 'POST',
                    headers: {
            'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        productId,
            quantity: parseInt(quantity),
            size
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Update cart count in header using our utility
            UI.updateCartCount(data.cartCount);
            UI.showToast('Product added to cart successfully!');
        } else {
            UI.showToast(data.message || 'Failed to add product to cart', true);
        }
    })
    .catch(error => {
        console.error('Error:', error);
        UI.showToast('An error occurred while adding to cart', true);
    });
}

// Add styles for color and size selectors
document.addEventListener('DOMContentLoaded', function() {
    // Add styles for color and size selectors
    const style = document.createElement('style');
    style.textContent = `
        .attribute-selector {
            margin-bottom: 15px;
        }
        .attribute-label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
        }
        .color-options, .size-options {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        .color-option, .size-option {
            position: relative;
        }
        .color-input, .size-input {
            position: absolute;
            opacity: 0;
            width: 0;
            height: 0;
        }
        .color-label {
            display: block;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: 2px solid #ddd;
            cursor: pointer;
            transition: all 0.2s;
        }
        .color-input:checked + .color-label {
            border-color: #007bff;
            box-shadow: 0 0 0 2px #fff, 0 0 0 4px #007bff;
        }
        .size-label {
            display: inline-block;
            min-width: 40px;
            height: 40px;
            line-height: 40px;
            text-align: center;
            padding: 0 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .size-input:checked + .size-label {
            background-color: #007bff;
            color: white;
            border-color: #007bff;
        }
    `;
    document.head.appendChild(style);
    
    // Set default selections
    const colorInputs = document.querySelectorAll('.color-input');
    const sizeInputs = document.querySelectorAll('.size-input');
    
    if (colorInputs.length > 0) {
        colorInputs[0].checked = true;
    }
    
    if (sizeInputs.length > 0) {
        sizeInputs[0].checked = true;
    }
});

document.addEventListener('DOMContentLoaded', function() {
    const productId = '<%= product._id %>';
    const reviewForm = document.getElementById('reviewForm');

    function loadReviews() {
        fetch(`/api/reviews/product/${productId}`, {
            headers: {
                'Cache-Control': 'no-cache, no-store, must-revalidate',
                'Pragma': 'no-cache',
                'Expires': '0'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success && data.reviews) {
                const reviewsList = document.getElementById('reviewsList');
                if (data.reviews.length > 0) {
                    reviewsList.innerHTML = data.reviews.map(review => `
                        <div class="review-item" data-review-id="${review._id}">
                            <div class="review-header">
                                <div class="reviewer-info">
                                    <h5 class="reviewer-name">${review.user ? review.user.name || review.user.email : 'Anonymous'}</h5>
                                    <div class="review-rating">
                                        ${Array.from({length: 5}, (_, i) => `
                                            <i class="fas fa-star ${i < review.rating ? 'text-warning' : 'text-muted'}"></i>
                                        `).join('')}
                                    </div>
                                </div>
                                <span class="review-date">${new Date(review.createdAt).toLocaleDateString()}</span>
                            </div>
                            <div class="review-content">
                                <h6 class="review-title">${review.title}</h6>
                                <p class="review-comment">${review.comment}</p>
                            </div>
                        </div>
                    `).join('');
                } else {
                    reviewsList.innerHTML = `
                        <div class="text-center py-4">
                            <i class="fas fa-comments fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No reviews yet. Be the first to review this product!</p>
                        </div>
                    `;
                }
            }
        })
        .catch(error => console.error('Error loading reviews:', error));
    }

    if (reviewForm) {
        reviewForm.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = {
                rating: document.querySelector('input[name="rating"]:checked').value,
                title: document.getElementById('reviewTitle').value,
                comment: document.getElementById('reviewComment').value
            };

            fetch(`/api/reviews/product/${productId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Cache-Control': 'no-cache, no-store, must-revalidate',
                    'Pragma': 'no-cache',
                    'Expires': '0'
                },
                body: JSON.stringify(formData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showToast('Review submitted successfully!');
                    reviewForm.reset();
                    loadReviews(); // Reload reviews after submission
                } else {
                    showToast(data.error || 'Failed to submit review', true);
                }
            })
            .catch(error => {
                console.error('Error submitting review:', error);
                showToast('Failed to submit review', true);
            });
        });
    }

    // Load reviews initially
    loadReviews();
});
    </script>

<style>
.rating-input {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
}

.rating-input input {
    display: none;
}

.rating-input label {
    cursor: pointer;
    padding: 0 5px;
    font-size: 1.5rem;
    color: #ddd;
}

.rating-input input:checked ~ label,
.rating-input input:checked ~ label ~ label {
    color: #ffc107;
}

.rating-input label:hover,
.rating-input label:hover ~ label {
    color: #ffc107;
}

.rating-input label i.active {
    color: #ffc107;
}

.verified-badge {
    color: #28a745;
}

.star-label {
    cursor: pointer;
    padding: 0 5px;
    font-size: 1.5rem;
    color: #ddd;
}

.star-label:hover,
.star-label:hover ~ .star-label {
    color: #ffc107;
}

.review-item {
    border-bottom: 1px solid var(--color-border);
    padding: 20px 20px;
    background-color: white;
    margin-bottom: 20px;
}

.review-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 15px;
}

.reviewer-info {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.reviewer-name {
    font-size: 16px;
    font-weight: 600;
    color: #333;
    margin: 0;
}

.review-rating {
    display: flex;
    gap: 2px;
}

.review-rating i {
    font-size: 14px;
}

.text-warning {
    color: #FFB800 !important;
}

.text-muted {
    color: #D1D5DB !important;
}

.review-date {
    font-size: 14px;
    color: #6B7280;
}

.review-title {
    font-size: 15px;
    font-weight: 500;
    color: #111827;
    margin-bottom: 8px;
}

.review-comment {
    font-size: 14px;
    color: #4B5563;
    line-height: 1.6;
    margin: 0;
}

/* Product Images */
.product-images {
