        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    /* Discount badge */
    .discount-badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: #2ecc71;
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    /* Section title adjustments */
    .section-header {
        padding: 0 0.75rem;
        margin-bottom: 1rem;
    }

    .section-header h2 {
        font-size: 1.5rem;
        font-weight: 600;
        color: #2d3436;
        margin-bottom: 0.5rem;
    }

    .view-all {
        color: var(--color-primary);
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .view-all i {
        font-size: 0.9rem;
    }

    /* Promotional Cards */
    .promo-card {
        margin-bottom: 1rem;
        height: 200px;
        padding: 1rem;
    }

    .col-md-4 {
        width: 100%;
        margin-bottom: 1rem;
    }

    .promo-card h3 {
        font-size: 1.2rem;
    }

    .promo-card h5 {
        font-size: 0.9rem;
    }

    .promo-card p {
        font-size: 0.8rem;
    }

    .promo-card .btn-shop {
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
    }

    /* Health & Safety Banner */
    .health-safety-banner {
        padding: 1.5rem 0;
        margin-bottom: 4rem; /* Add space for mobile bottom navigation */
    }

    .health-safety-banner h4 {
        font-size: 1.1rem;
    }

    .health-safety-banner p {
        font-size: 0.9rem;
    }

    /* General Spacing */
    .mt-4 {
        margin-top: 2rem !important;
    }

    .container {
        padding-left: 15px;
        padding-right: 15px;
    }

    /* Hide categories sidebar on mobile */
    .categories-sidebar {
        display: none;
    }

    /* Adjust hero banner to full width */
    .col-lg-9 {
        width: 100%;
        padding: 0;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const expandButtons = document.querySelectorAll('.category-expand');
    
    expandButtons.forEach(button => {
        button.addEventListener('click', function() {
            // Log category information when expanding/collapsing
            console.log('Toggling category:', {
                categoryId: this.dataset.categoryId,
                categoryName: this.dataset.categoryName,
                isExpanded: !this.classList.contains('expanded')
            });
            
            // Toggle the expanded class
            this.classList.toggle('expanded');
            
            // Find the subcategory list
            const categoryItem = this.closest('.category-item');
            const subcategoryList = categoryItem.nextElementSibling;
            
            if (subcategoryList && subcategoryList.classList.contains('subcategory-list')) {
                // Toggle subcategory visibility with smooth animation
                if (subcategoryList.style.display === 'none') {
                    console.log('Expanding subcategories for:', this.dataset.categoryName);
                    subcategoryList.style.display = 'block';
                    subcategoryList.style.maxHeight = '0';
                    subcategoryList.style.opacity = '0';
                    
                    // Trigger reflow
                    subcategoryList.offsetHeight;
                    
                    subcategoryList.style.maxHeight = subcategoryList.scrollHeight + 'px';
                    subcategoryList.style.opacity = '1';
                    subcategoryList.style.transition = 'max-height 0.3s ease-in-out, opacity 0.3s ease-in-out';
                } else {
                    console.log('Collapsing subcategories for:', this.dataset.categoryName);
                    subcategoryList.style.maxHeight = '0';
                    subcategoryList.style.opacity = '0';
                    
                    setTimeout(() => {
                        subcategoryList.style.display = 'none';
                    }, 300);
                }
            }
        });
    });
});
</script> 