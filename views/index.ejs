<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <!-- First Row: Categories and Hero -->
        <div class="row">
            <!-- Categories Sidebar -->
            <div class="col-lg-3">
                <div class="categories-sidebar">
                    <ul class="list-unstyled mb-0">
                        <% if (categories && categories.length > 0) { %>
                            <% categories.forEach(category => { %>
                                <li>
                                    <div class="category-item">
                                        <a href="/shop?category=<%= category._id %>" class="d-flex align-items-center">
                                            <i class="<%= getCategoryIcon(category.name) %>"></i>
                                            <span class="ms-2"><%= category.name %></span>
                                        </a>
                                        <% if (categoryMap.has(category._id.toString())) { %>
                                            <button type="button" class="category-expand" 
                                                    aria-label="Expand category"
                                                    data-category-id="<%= category._id %>"
                                                    data-category-name="<%= category.name %>">+</button>
                                        <% } %>
                                    </div>
                                    <% if (categoryMap.has(category._id.toString())) { %>
                                        <ul class="list-unstyled subcategory-list" style="display: none;">
                                            <% categoryMap.get(category._id.toString()).forEach(subcategory => { %>
                                                <li>
                                                    <div class="category-item">
                                                        <a href="/shop?category=<%= subcategory._id %>" class="d-flex align-items-center">
                                                            <i class="<%= getCategoryIcon(subcategory.name) %>"></i>
                                                            <span class="ms-2"><%= subcategory.name %></span>
                                                        </a>
                                                    </div>
                                                </li>
                                            <% }); %>
                                        </ul>
                                    <% } %>
                                </li>
                            <% }); %>
                        <% } else { %>
                            <li>
                                <div class="category-item">
                                    <a href="/shop" class="d-flex align-items-center">
                                        <i class="fas fa-tag"></i>
                                        <span class="ms-2">All Categories</span>
                                    </a>
                                </div>
                            </li>
                        <% } %>
                    </ul>
