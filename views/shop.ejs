<div class="container mt-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active">Shop</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Sidebar -->
        <div class="col-lg-3">
            <div class="shop-sidebar">
                <!-- Price Filter -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Widget price filter</h5>
                        <div class="price-range-inputs mb-3">
                            <div class="d-flex align-items-center">
                                <div class="price-input-group">
                                    <label>Min price</label>
                                    <input type="number" value="0" class="form-control">
                                </div>
                                <span class="mx-2">-</span>
                                <div class="price-input-group">
                                    <label>Max price</label>
                                    <input type="number" value="30" class="form-control">
                                </div>
                            </div>
                        </div>
                        <div id="priceRange" class="mb-3"></div>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="price-text">Price: $0 — $30</div>
                            <button class="btn btn-filter">Filter</button>
                        </div>
                    </div>
                </div>

                <!-- Categories -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Product Categories</h5>
                        <ul class="categories-list">
                            <li>
                                <div class="category-item active">
                                    <label class="d-flex align-items-center">
                                        <input type="checkbox" class="form-check-input me-2" checked>
                                        <span class="category-name">Fruits & Vegetables</span>
                                        <button class="btn-expand">+</button>
                                    </label>
                                    
                                </div>
                            </li>
                            <li>
                                <div class="category-item">
                                    <label class="d-flex align-items-center">
                                        <input type="checkbox" class="form-check-input me-2">
                                        <span class="category-name">Baby & Pregnancy</span>
                                    </label>
                                </div>
                            </li>
                            <li>
                                <div class="category-item">
                                    <label class="d-flex align-items-center">
                                        <input type="checkbox" class="form-check-input me-2">
                                        <span class="category-name">Beverages</span>
                                        <button class="btn-expand">+</button>
                                    </label>
                                    
                                </div>
                            </li>
                            <li>
                                <div class="category-item">
                                    <label class="d-flex align-items-center">
                                        <input type="checkbox" class="form-check-input me-2">
                                        <span class="category-name">Meats & Seafood</span>
                                        <button class="btn-expand">+</button>
                                    </label>
                                    
                                </div>
                            </li>
                            <li>
                                <div class="category-item">
                                    <label class="d-flex align-items-center">
                                        <input type="checkbox" class="form-check-input me-2">
                                        <span class="category-name">Biscuits & Snacks</span>
                                    </label>
                                </div>
                            </li>
                            <li>
                                <div class="category-item">
                                    <label class="d-flex align-items-center">
                                        <input type="checkbox" class="form-check-input me-2">
                                        <span class="category-name">Breads & Bakery</span>
                                        <button class="btn-expand">+</button>
                                    </label>
                                    
                                </div>
                            </li>
                            <li>
                                <div class="category-item">
                                    <label class="d-flex align-items-center">
                                        <input type="checkbox" class="form-check-input me-2">
                                        <span class="category-name">Breakfast & Dairy</span>
                                        <button class="btn-expand">+</button>
                                    </label>
                                    
                                </div>
                            </li>
                            <li>
                                <div class="category-item">
                                    <label class="d-flex align-items-center">
                                        <input type="checkbox" class="form-check-input me-2">
                                        <span class="category-name">Frozen Foods</span>
                                    </label>
                                </div>
                            </li>
                            <li>
                                <div class="category-item">
                                    <label class="d-flex align-items-center">
                                        <input type="checkbox" class="form-check-input me-2">
                                        <span class="category-name">Grocery & Staples</span>
                                    </label>
                                </div>
                            </li>
                            <li>
                                <div class="category-item">
                                    <label class="d-flex align-items-center">
                                        <input type="checkbox" class="form-check-input me-2">
                                        <span class="category-name">Healthcare</span>
                                    </label>
                                </div>
                            </li>
                            <li>
                                <div class="category-item">
                                    <label class="d-flex align-items-center">
                                        <input type="checkbox" class="form-check-input me-2">
                                        <span class="category-name">Household Needs</span>
                                    </label>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Filter by Color -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Filter by Color</h5>
                        <div class="color-filters">
                            <div class="color-filter">
                                <label class="d-flex align-items-center">
                                    <span class="color-dot bg-success"></span>
                                    <span class="color-name">Green</span>
                                    <span class="color-count">(1)</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Filter by Brand -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Filter by Brand</h5>
                        <div class="brand-filters">
                            <div class="brand-filter">
                                <label class="d-flex align-items-center">
                                    <input type="checkbox" class="form-check-input me-2">
                                    <span class="brand-name">Fresh</span>
                                    <span class="brand-count">(1)</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product Status -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Product Status</h5>
                        <div class="status-filters">
                            <div class="status-filter">
                                <label class="d-flex align-items-center">
                                    <input type="checkbox" class="form-check-input me-2">
                                    <span>In Stock</span>
                                </label>
                            </div>
                            <div class="status-filter">
                                <label class="d-flex align-items-center">
                                    <input type="checkbox" class="form-check-input me-2">
                                    <span>On Sale</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Products Grid -->
        <div class="col-lg-9">
            <div class="products-grid-container">
                <!-- Sort and View Options -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <select class="form-select">
                            <option>Sort by latest</option>
                            <option>Price: Low to High</option>
                            <option>Price: High to Low</option>
                            <option>Name: A to Z</option>
                        </select>
                    </div>
                    <div class="view-options">
                        <button class="btn btn-outline-secondary active">
                            <i class="fas fa-th-large"></i>
                        </button>
                        <button class="btn btn-outline-secondary">
                            <i class="fas fa-list"></i>
                        </button>
                    </div>
                </div>

                <!-- Products Grid -->
                <div class="row g-4" id="products-grid">
                    <% if (products && products.length > 0) { %>
                        <% products.forEach(product => { %>
                            <div class="col-md-6 col-lg-4 product-item">
                                <a href="/shop/product/<%= product._id %>" class="product-link">
                                    <div class="product-card">
                                        <div class="product-image">
                                            <img src="<%= product.images && product.images.length > 0 ? (product.images.find(img => img.isMain)?.url || product.images[0]?.url) : '/images/products/default-product.jpg' %>" 
                                                 alt="<%= product.name %>">
                                            <div class="badge-overlay">
                                                <span class="badge bg-danger">-15%</span>
                                            </div>
                                        </div>
                                        <div class="product-info">
                                            <h3><%= product.name %></h3>
                                            <div class="price">
                                                <span class="new-price">$<%= (product.price * 0.85).toFixed(2) %></span>
                                                <span class="old-price">$<%= product.price.toFixed(2) %></span>
                                            </div>
                                            <div class="button-group">
                                                <button class="btn-wishlist" onclick="event.preventDefault(); event.stopPropagation();">
                                                    <i class="fas fa-heart"></i>
                                                </button>
                                                <button class="btn-add" onclick="event.preventDefault(); event.stopPropagation();">
                                                    <% if (product.stock > 0) { %>
                                                        Add to cart
                                                    <% } else { %>
                                                        Out of Stock
                                                    <% } %>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <!-- No Products Available Message -->
                        <div class="col-12 text-center py-5">
                            <div class="no-products-message">
                                <i class="fas fa-box-open fa-4x mb-3 text-muted"></i>
                                <h3>No Products Available</h3>
                                <p class="text-muted">We couldn't find any products matching your criteria.</p>
                                <p class="text-muted">Please check back later or try adjusting your filters.</p>
                            </div>
                        </div>
                    <% } %>
                </div>

                <!-- Loading Spinner (Hidden by default) -->
                <div id="loading-spinner" class="text-center my-4 d-none">
                    <div class="loading-animation">
                        <div class="spinner-grow text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div class="spinner-grow text-success" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div class="spinner-grow text-info" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div class="spinner-grow text-warning" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div class="spinner-grow text-danger" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                    <p class="mt-2 text-muted">Loading more products...</p>
                </div>

                <!-- No More Products Message (Hidden by default) -->
                <div id="no-more-products" class="text-center my-4 d-none">
                    <p class="text-muted">No more products to load</p>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/nouislider@14.6.3/distribute/nouislider.min.css">
<script src="https://cdn.jsdelivr.net/npm/nouislider@14.6.3/distribute/nouislider.min.js"></script>

<style>
/* Loading Animation */
.loading-animation {
    display: flex;
    justify-content: center;
    gap: 8px;
}

.loading-animation .spinner-grow {
    width: 12px;
    height: 12px;
    animation-delay: calc(0.1s * var(--i, 0));
}

.loading-animation .spinner-grow:nth-child(1) { --i: 0; }
.loading-animation .spinner-grow:nth-child(2) { --i: 1; }
.loading-animation .spinner-grow:nth-child(3) { --i: 2; }
.loading-animation .spinner-grow:nth-child(4) { --i: 3; }
.loading-animation .spinner-grow:nth-child(5) { --i: 4; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Log all products from the database - with error handling
    try {
        const productsData = '<%- JSON.stringify(products || []) %>';
        console.log('Products from database:', productsData);
    } catch (error) {
        console.error('Error logging products:', error);
    }
    
    // Price Range Slider - temporarily disabled
    /*
    const priceRangeSlider = document.getElementById('priceRange');
    if (priceRangeSlider) {
        noUiSlider.create(priceRangeSlider, {
            start: [0, 30],
            connect: true,
            range: {
                'min': 0,
                'max': 30
            },
            format: {
                to: function (value) {
                    return Math.round(value);
                },
                from: function (value) {
                    return Number(value);
                }
            }
        });

        const priceMin = document.getElementById('priceMin');
        const priceMax = document.getElementById('priceMax');

        // Only add event listeners if the elements exist
        if (priceMin && priceMax) {
            priceRangeSlider.noUiSlider.on('update', function (values, handle) {
                if (handle === 0) {
                    priceMin.innerHTML = values[0];
                } else {
                    priceMax.innerHTML = values[1];
                }
            });
        }
    }
    */

    // Handle expand/collapse for categories
    const expandButtons = document.querySelectorAll('.btn-expand');
    expandButtons.forEach(button => {
        button.addEventListener('click', function() {
            this.classList.toggle('active');
        });
    });

    // Infinite scroll implementation
    const productGrid = document.querySelector('.product-grid');
    const loadingSpinner = document.querySelector('.loading-spinner');
    const noMoreProducts = document.querySelector('.no-more-products');
    let currentPage = 1;
    let isLoading = false;
    let hasMoreProducts = true;

    // Function to create product card HTML
    function createProductCard(product) {
        return `
            <div class="product-card">
                <div class="product-image">
                    <img src="${product.images[0]?.url || '/images/products/default.jpg'}" alt="${product.name}">
                    <div class="product-actions">
                        <button class="action-btn wishlist-btn" title="Add to Wishlist">
                            <i class="fas fa-heart"></i>
                        </button>
                        <button class="action-btn quickview-btn" title="Quick View">
                            <i class="fas fa-eye"></i>
                        </button>
                        <button class="action-btn add-to-cart-btn" title="Add to Cart">
                            <i class="fas fa-shopping-cart"></i>
                        </button>
                    </div>
                </div>
                <div class="product-info">
                    <h3 class="product-title">${product.name}</h3>
                    <div class="product-price">$${product.price.toFixed(2)}</div>
                    <div class="product-rating">
                        ${generateStarRating(product.rating)}
                        <span class="rating-count">(${product.reviews?.length || 0})</span>
                    </div>
                </div>
            </div>
        `;
    }

    // Function to load more products
    async function loadMoreProducts() {
        if (isLoading || !hasMoreProducts) return;
        
        try {
            isLoading = true;
            loadingSpinner.style.display = 'block';
            noMoreProducts.style.display = 'none';

            const response = await fetch(`/shop/api/products?page=${currentPage + 1}`);
            if (!response.ok) throw new Error('Failed to fetch products');
            
            const data = await response.json();
            
            if (data.products && data.products.length > 0) {
                data.products.forEach(product => {
                    const productCard = createProductCard(product);
                    productGrid.insertAdjacentHTML('beforeend', productCard);
                });
                currentPage++;
                hasMoreProducts = !data.isLastPage;
            } else {
                hasMoreProducts = false;
            }

            if (!hasMoreProducts) {
                noMoreProducts.style.display = 'block';
            }
        } catch (error) {
            console.error('Error loading more products:', error);
        } finally {
            isLoading = false;
            loadingSpinner.style.display = 'none';
        }
    }

    // Intersection Observer for infinite scroll
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting && !isLoading && hasMoreProducts) {
                loadMoreProducts();
            }
        });
    }, {
        root: null,
        rootMargin: '100px',
        threshold: 0.1
    });

    // Start observing the sentinel element
    const sentinel = document.querySelector('.loading-spinner');
    if (sentinel) {
        observer.observe(sentinel);
    }
});
</script> 