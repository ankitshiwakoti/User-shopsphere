<div class="container mt-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/shop">Shop</a></li>
            <% if (activeCategory) { %>
                <li class="breadcrumb-item active"><%= activeCategory.name %></li>
            <% } %>
        </ol>
    </nav>

    <div class="row">
        <!-- Sidebar -->
        <div class="col-lg-3">
            <div class="shop-sidebar">
                <!-- Add a global clear all filters button at the top of the sidebar -->
                <div class="clear-all-filters">
                    <a href="/shop" class="btn btn-outline-secondary btn-sm w-100">Clear All Filters</a>
                </div>

                <!-- Price Filter -->
                <div class="price-filter">
                    <div class="filter-header">
                        <h3>Price Range</h3>
                        <button type="button" class="btn-clear-filter" id="clearPriceFilter">Clear</button>
                    </div>
                    <form id="priceFilterForm" method="GET" action="/shop">
                        <!-- Preserve category selections -->
                        <% if (filters.categories && filters.categories.length > 0) { %>
                            <% filters.categories.forEach(categoryId => { %>
                                <input type="hidden" name="category" value="<%= categoryId %>">
                            <% }); %>
                        <% } %>
                        
                        <div class="price-slider-container">
                            <div class="price-slider">
                                <div class="slider-track"></div>
                                <input type="range" class="min-range" min="0" max="1000" value="<%= filters.minPrice || 0 %>" name="minPrice">
                                <input type="range" class="max-range" min="0" max="1000" value="<%= filters.maxPrice || 1000 %>" name="maxPrice">
                            </div>
                            <div class="price-values">
                                <span class="min-value">$<%= filters.minPrice || 0 %></span>
                                <span class="max-value">$<%= filters.maxPrice || 1000 %></span>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Category Filter -->
                <div class="category-filter">
                    <div class="filter-header">
                        <h3>Categories</h3>
                        <button type="button" class="btn-clear-filter" id="clearCategoryFilter">Clear</button>
                    </div>
                    <form id="categoryForm" action="/shop" method="GET">
                        <!-- Preserve price filter values -->
                        <input type="hidden" name="minPrice" value="<%= filters.minPrice %>">
                        <input type="hidden" name="maxPrice" value="<%= filters.maxPrice %>">
                        
                        <ul class="category-list">
                            <% categories.forEach(function(category) { %>
                                <li class="category-item">
                                    <div class="category-header">
                                        <label class="checkbox-container">
                                            <input type="checkbox" 
                                                   name="category" 
                                                   value="<%= category._id %>"
                                                   <%= filters.categories.includes(category._id.toString()) ? 'checked' : '' %>>
                                            <span class="checkmark"></span>
                                            <%= category.name %>
                                        </label>
                                        <% if (category.children && category.children.length > 0) { %>
                                            <button type="button" class="expand-btn" data-category="<%= category._id %>">
                                                <i class="fas fa-plus"></i>
                                            </button>
                                        <% } %>
                                    </div>
                                    <% if (category.children && category.children.length > 0) { %>
                                        <ul class="subcategory-list" data-parent="<%= category._id %>" style="display: none;">
                                            <% category.children.forEach(function(subcategory) { %>
                                                <li class="subcategory-item">
                                                    <label class="checkbox-container">
                                                        <input type="checkbox" 
                                                               name="category" 
                                                               value="<%= subcategory._id %>"
                                                               <%= filters.categories.includes(subcategory._id.toString()) ? 'checked' : '' %>>
                                                        <span class="checkmark"></span>
                                                        <%= subcategory.name %>
                                                    </label>
                                                </li>
                                            <% }); %>
                                        </ul>
                                    <% } %>
                                </li>
                            <% }); %>
                        </ul>
                    </form>
                </div>

                <!-- Filter by Color -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Filter by Color</h5>
                        <div class="color-filters">
                            <div class="color-filter">
                                <label class="d-flex align-items-center">
                                    <span class="color-dot bg-success"></span>
                                    <span class="color-name">Green</span>
                                    <span class="color-count">(1)</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Filter by Brand -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Filter by Brand</h5>
                        <div class="brand-filters">
                            <div class="brand-filter">
                                <label class="d-flex align-items-center">
                                    <input type="checkbox" class="form-check-input me-2">
                                    <span class="brand-name">Fresh</span>
                                    <span class="brand-count">(1)</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product Status -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">Product Status</h5>
                        <div class="status-filters">
                            <div class="status-filter">
                                <label class="d-flex align-items-center">
                                    <input type="checkbox" class="form-check-input me-2">
                                    <span>In Stock</span>
                                </label>
                            </div>
                            <div class="status-filter">
                                <label class="d-flex align-items-center">
                                    <input type="checkbox" class="form-check-input me-2">
                                    <span>On Sale</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="shop-header mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-0">
                            <% if (activeCategory) { %>
                                <%= activeCategory.name %>
                            <% } else { %>
                                All Products
                            <% } %>
                        </h4>
                        <small class="text-muted"><%= products.length %> products found</small>
                    </div>
                    <!-- Rest of the shop header -->
                </div>
            </div>
            
            <div class="products-grid-container">
                <!-- Sort and View Options -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <select class="form-select">
                            <option>Sort by latest</option>
                            <option>Price: Low to High</option>
                            <option>Price: High to Low</option>
                            <option>Name: A to Z</option>
                        </select>
                    </div>
                    <div class="view-options">
                        <button class="btn btn-outline-secondary active">
                            <i class="fas fa-th-large"></i>
                        </button>
                        <button class="btn btn-outline-secondary">
                            <i class="fas fa-list"></i>
                        </button>
                    </div>
                </div>

                <!-- Products Grid -->
                <div class="row g-4" id="products-grid">
                    <% if (products && products.length > 0) { %>
                        <% products.forEach(product => { %>
                            <div class="col-md-6 col-lg-4 mb-4">
                                <a href="/shop/product/<%= product._id %>" class="product-link">
                                    <div class="product-card" data-product-id="<%= product._id %>">
                                        <div class="product-image">
                                            <img src="<%= product.images && product.images.length > 0 ? (product.images.find(img => img.isMain)?.url || product.images[0]?.url) : '/images/products/default-product.jpg' %>" 
                                                 alt="<%= product.name %>">
                                            <div class="badge-overlay">
                                                <span class="badge bg-danger">-15%</span>
                                            </div>
                                        </div>
                                        <div class="product-info">
                                            <h3><%= product.name %></h3>
                                            <div class="price">
                                                <span class="new-price">$<%= (product.price * 0.85).toFixed(2) %></span>
                                                <span class="old-price">$<%= product.price.toFixed(2) %></span>
                                            </div>
                                            <div class="button-group">
                                                <button class="btn-wishlist" onclick="event.preventDefault(); event.stopPropagation();">
                                                    <i class="fas fa-heart <%= product.isInWishlist ? 'text-danger' : '' %>"></i>
                                                </button>
                                                <button class="btn-add" onclick="event.preventDefault(); event.stopPropagation();">
                                                    <% if (product.stock > 0) { %>
                                                        Add to cart
                                                    <% } else { %>
                                                        Out of Stock
                                                    <% } %>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <!-- No Products Available Message -->
                        <div class="col-12 text-center py-5">
                            <div class="no-products-message">
                                <i class="fas fa-box-open fa-4x mb-3 text-muted"></i>
                                <h3>No Products Available</h3>
                                <p class="text-muted">We couldn't find any products matching your criteria.</p>
                                <p class="text-muted">Please check back later or try adjusting your filters.</p>
                            </div>
                        </div>
                    <% } %>
                </div>

                <!-- Sentinel Element for Infinite Scroll -->
                <div id="sentinel" class="h-10"></div>

                <!-- Loading Spinner (Hidden by default) -->
                <div id="loading-spinner" class="text-center my-4 d-none">
                    <div class="loading-animation">
                        <div class="spinner-grow text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div class="spinner-grow text-success" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div class="spinner-grow text-info" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div class="spinner-grow text-warning" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div class="spinner-grow text-danger" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                    <p class="mt-2 text-muted">Loading more products...</p>
                </div>

                <!-- No More Products Message (Hidden by default) -->
                <div id="no-more-products" class="text-center my-4 d-none">
                    <p class="text-muted">No more products to load</p>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/nouislider@14.6.3/distribute/nouislider.min.css">
<script src="https://cdn.jsdelivr.net/npm/nouislider@14.6.3/distribute/nouislider.min.js"></script>

<style>
/* Loading Animation */
.loading-animation {
    display: flex;
    justify-content: center;
    gap: 8px;
}

.loading-animation .spinner-grow {
    width: 12px;
    height: 12px;
    animation-delay: calc(0.1s * var(--i, 0));
}

.loading-animation .spinner-grow:nth-child(1) { --i: 0; }
.loading-animation .spinner-grow:nth-child(2) { --i: 1; }
.loading-animation .spinner-grow:nth-child(3) { --i: 2; }
.loading-animation .spinner-grow:nth-child(4) { --i: 3; }
.loading-animation .spinner-grow:nth-child(5) { --i: 4; }

.category-filter {
    margin-bottom: 2rem;
}

.category-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.category-item {
    margin-bottom: 0.5rem;
}

.category-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.subcategory-list {
    list-style: none;
    padding-left: 1.5rem;
    margin: 0.5rem 0;
}

.subcategory-item {
    margin: 0.25rem 0;
}

.checkbox-container {
    display: flex;
    align-items: center;
    cursor: pointer;
    user-select: none;
}

.checkbox-container input {
    margin-right: 0.5rem;
}

.expand-btn {
    background: none;
    border: none;
    color: #666;
    cursor: pointer;
    padding: 0.25rem;
    transition: transform 0.3s ease;
}

.expand-btn.expanded {
    transform: rotate(45deg);
}

.subcategory-list {
    transition: max-height 0.3s ease-out;
    overflow: hidden;
}

.price-filter {
    margin-bottom: 2rem;
}

.price-slider-container {
    padding: 1rem 0;
}

.price-slider {
    position: relative;
    width: 100%;
    height: 5px;
    background: #e0e0e0;
    border-radius: 5px;
    margin: 1rem 0;
}

.slider-track {
    position: absolute;
    height: 100%;
    background: #4CAF50;
    border-radius: 5px;
    pointer-events: none;
}

.min-range,
.max-range {
    position: absolute;
    width: 100%;
    height: 100%;
    background: none;
    pointer-events: none;
    -webkit-appearance: none;
}

.min-range::-webkit-slider-thumb,
.max-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 20px;
    height: 20px;
    background: #4CAF50;
    border-radius: 50%;
    cursor: pointer;
    pointer-events: auto;
}

.price-values {
    display: flex;
    justify-content: space-between;
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: #666;
}

/* Add these styles to your existing CSS */
.filter-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
}

.btn-clear-filter {
    background: none;
    border: none;
    color: #666;
    font-size: 0.9rem;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    transition: all 0.2s ease;
}

.btn-clear-filter:hover {
    color: #333;
    background-color: #f0f0f0;
}

.clear-all-filters {
    margin-bottom: 1.5rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid #eee;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Log all products from the database - with error handling
    try {
        const productsData = '<%- JSON.stringify(products || []) %>';
        console.log('Products from database:', productsData);
    } catch (error) {
        console.error('Error logging products:', error);
    }
    
    const priceForm = document.getElementById('priceFilterForm');
    const minRange = priceForm.querySelector('.min-range');
    const maxRange = priceForm.querySelector('.max-range');
    const track = priceForm.querySelector('.slider-track');
    const minValue = priceForm.querySelector('.min-value');
    const maxValue = priceForm.querySelector('.max-value');

    let isDragging = false;
    let debounceTimer = null;

    function updateSlider() {
        const min = parseInt(minRange.value);
        const max = parseInt(maxRange.value);

        if (min > max) {
            const temp = min;
            minRange.value = max;
            maxRange.value = temp;
        }

        const percent1 = (min / minRange.max) * 100;
        const percent2 = (max / maxRange.max) * 100;

        track.style.left = percent1 + '%';
        track.style.width = (percent2 - percent1) + '%';

        minValue.textContent = '$' + min;
        maxValue.textContent = '$' + max;
    }

    function submitForm() {
        if (!isDragging) {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                priceForm.submit();
            }, 1000); // Wait 1 second after the user stops dragging
        }
    }

    // Update visual state while dragging
    minRange.addEventListener('input', () => {
        isDragging = true;
        updateSlider();
    });

    maxRange.addEventListener('input', () => {
        isDragging = true;
        updateSlider();
    });

    // Submit form when user releases the slider
    minRange.addEventListener('change', () => {
        isDragging = false;
        submitForm();
    });

    maxRange.addEventListener('change', () => {
        isDragging = false;
        submitForm();
    });

    // Clear price filter
    document.getElementById('clearPriceFilter').addEventListener('click', function() {
        // Reset to default values
        minRange.value = 0;
        maxRange.value = 1000;
        updateSlider();
        
        // Remove price parameters from URL and submit
        const url = new URL(window.location.href);
        url.searchParams.delete('minPrice');
        url.searchParams.delete('maxPrice');
        window.location.href = url.toString();
    });

    // Clear category filter
    document.getElementById('clearCategoryFilter').addEventListener('click', function() {
        // Uncheck all checkboxes
        const checkboxes = document.querySelectorAll('#categoryForm input[type="checkbox"]');
        checkboxes.forEach(checkbox => {
            checkbox.checked = false;
        });
        
        // Remove category parameters from URL and submit
        const url = new URL(window.location.href);
        url.searchParams.delete('category');
        window.location.href = url.toString();
    });

    // Initial update
    updateSlider();

    // Handle both infinite scroll and category expansion
    const expandButtons = document.querySelectorAll('.expand-btn');
    const sentinel = document.querySelector('#sentinel');
    const loadingSpinner = document.querySelector('#loading-spinner');
    const noMoreProducts = document.querySelector('#no-more-products');
    let currentPage = 1;
    let isLoading = false;
    let hasMoreProducts = true;
    
    // Function to load more products
    async function loadMoreProducts() {
        if (isLoading || !hasMoreProducts) return;
        
        try {
            isLoading = true;
            loadingSpinner.classList.remove('d-none');
            
            // Get current URL parameters
            const urlParams = new URLSearchParams(window.location.search);
            urlParams.set('page', currentPage + 1);
            
            // Fetch more products
            const response = await fetch(`/shop/api/products?${urlParams.toString()}`);
            const data = await response.json();
            
            if (data.products && data.products.length > 0) {
                // Append new products to the grid
                const productsGrid = document.querySelector('#products-grid');
                data.products.forEach(product => {
                    const productHtml = `
                        <div class="col-md-6 col-lg-4 mb-4">
                            <a href="/shop/product/${product._id}" class="product-link">
                                <div class="product-card" data-product-id="${product._id}">
                                    <div class="product-image">
                                        <img src="${product.images && product.images.length > 0 ? (product.images.find(img => img.isMain)?.url || product.images[0]?.url) : '/images/products/default-product.jpg'}" 
                                             alt="${product.name}">
                                        <div class="badge-overlay">
                                            <span class="badge bg-danger">-15%</span>
                                        </div>
                                    </div>
                                    <div class="product-info">
                                        <h3>${product.name}</h3>
                                        <div class="price">
                                            <span class="new-price">$${(product.price * 0.85).toFixed(2)}</span>
                                            <span class="old-price">$${product.price.toFixed(2)}</span>
                                        </div>
                                        <div class="button-group">
                                            <button class="btn-wishlist" onclick="event.preventDefault(); event.stopPropagation();">
                                                <i class="fas fa-heart${product.isInWishlist ? ' text-danger' : ''}"></i>
                                            </button>
                                            <button class="btn-add" onclick="event.preventDefault(); event.stopPropagation();">
                                                ${product.stock > 0 ? 'Add to cart' : 'Out of Stock'}
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    `;
                    productsGrid.insertAdjacentHTML('beforeend', productHtml);
                });
                
                currentPage++;
                hasMoreProducts = !data.isLastPage;
                
                if (!hasMoreProducts) {
                    noMoreProducts.classList.remove('d-none');
                }
            } else {
                hasMoreProducts = false;
                noMoreProducts.classList.remove('d-none');
            }
        } catch (error) {
            console.error('Error loading more products:', error);
        } finally {
            isLoading = false;
            loadingSpinner.classList.add('d-none');
        }
    }
    
    // Infinite scroll handling
    if (sentinel) {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting && !isLoading && hasMoreProducts) {
                    loadMoreProducts();
                }
            });
        }, {
            rootMargin: '100px'
        });
        
        observer.observe(sentinel);
    }

    // Handle category expansion
    expandButtons.forEach(button => {
        button.addEventListener('click', function() {
            const categoryId = this.dataset.category;
            const subcategoryList = document.querySelector(`.subcategory-list[data-parent="${categoryId}"]`);
            
            if (subcategoryList) {
                const isExpanded = this.classList.contains('expanded');
                this.classList.toggle('expanded');
                subcategoryList.style.display = isExpanded ? 'none' : 'block';
            }
        });
    });

    // Auto-submit form when checkbox changes
    const checkboxes = document.querySelectorAll('input[type="checkbox"]');
    checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            document.getElementById('categoryForm').submit();
        });
    });

    // Show subcategories if any child category is selected
    const selectedSubcategories = document.querySelectorAll('.subcategory-item input[type="checkbox"]:checked');
    selectedSubcategories.forEach(checkbox => {
        const subcategoryList = checkbox.closest('.subcategory-list');
        if (subcategoryList) {
            subcategoryList.style.display = 'block';
            const expandBtn = document.querySelector(`.expand-btn[data-category="${subcategoryList.dataset.parent}"]`);
            if (expandBtn) {
                expandBtn.classList.add('expanded');
            }
        }
    });

    // Add to cart buttons
    const addToCartButtons = document.querySelectorAll('.btn-add');
    
    addToCartButtons.forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            const productCard = this.closest('.product-card');
            const productId = productCard.dataset.productId;
            
            fetch('/api/cart/add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    productId,
                    quantity: 1
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Update cart count in header
                    const cartCount = document.querySelector('.cart-count');
                    if (cartCount) {
                        cartCount.textContent = data.cartCount;
                    }
                    showToast('Product added to cart successfully!', 'success');
                } else {
                    showToast(data.message || 'Failed to add product to cart', 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showToast('An error occurred while adding to cart', 'error');
            });
        });
    });
    
    // Add to wishlist buttons
    const addToWishlistButtons = document.querySelectorAll('.btn-wishlist');
    
    addToWishlistButtons.forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            const productCard = this.closest('.product-card');
            const productId = productCard.dataset.productId;
            const icon = this.querySelector('i');
            const isInWishlist = icon.classList.contains('text-danger');
            
            const endpoint = isInWishlist ? `/api/wishlist/remove/${productId}` : `/api/wishlist/add/${productId}`;
            const method = isInWishlist ? 'DELETE' : 'POST';
            
            fetch(endpoint, {
                method: method,
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Toggle wishlist icon
                    icon.classList.toggle('text-danger');
                    
                    // Update wishlist count in header
                    const wishlistCount = document.querySelector('.wishlist-count');
                    if (wishlistCount) {
                        wishlistCount.textContent = data.wishlistCount;
                    }
                    
                    // Show appropriate message
                    const message = isInWishlist ? 'Product removed from wishlist' : 'Product added to wishlist';
                    showToast(message, 'success');
                } else {
                    showToast(data.message || 'Failed to update wishlist', 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showToast('An error occurred while updating wishlist', 'error');
            });
        });
    });
    
    // Show toast message
    function showToast(message, type = 'success') {
        const toast = document.getElementById('toast');
        const toastBody = toast.querySelector('.toast-body');
        
        // Set toast color based on type
        toast.className = `toast align-items-center text-white border-0 bg-${type}`;
        
        // Set message
        toastBody.textContent = message;
        
        // Show toast
        const bsToast = new bootstrap.Toast(toast, {
            animation: true,
            autohide: true,
            delay: 2000
        });
        bsToast.show();
    }
});
</script>

